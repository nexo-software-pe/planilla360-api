# Valores SOLO para desarrollo local. Copiar este archivo entero a .env es seguro: cada valor coincide con el
# por defecto de compose.yaml y de application-local.yml (lo verifica ConfiguracionLocalTests).
# Docker Compose lee .env; la API que corre en el host NO lo lee: usa variables de entorno exportadas o sus
# valores por defecto. Si cambias una variable de una pareja (p. ej. POSTGRES_PASSWORD y DB_PASSWORD),
# cámbiala en las dos puntas y actualiza los valores por defecto del repo.
# En cualquier otro entorno los valores son fuertes, distintos de estos y se definen fuera del repositorio.
# NUNCA subas .env al repositorio.

SPRING_PROFILES_ACTIVE=local
PORT=8080

# --- Base de datos (docker compose y API) ---
POSTGRES_DB=planilla360
POSTGRES_USER=planilla360
POSTGRES_PASSWORD=planilla360
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/planilla360
DB_USER=planilla360
DB_PASSWORD=planilla360

# --- Seguridad ---
# Obligatorio fuera de local (mínimo 32 caracteres, aleatorio). Genera uno con:  openssl rand -base64 48
# En local, si lo omites, se genera uno efímero (los tokens dejan de valer al reiniciar la API).
# JWT_SECRET=
# Orígenes permitidos por CORS, separados por coma (en local: el front en http://localhost:4200).
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Caché y mensajería (perfil "messaging" de compose) ---
# CACHE_TYPE=redis activa Redis; con "simple" (por defecto) la caché es en memoria.
CACHE_TYPE=simple
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
RABBITMQ_USER=planilla360
RABBITMQ_PASSWORD=planilla360

# --- Almacenamiento de boletas (MinIO local) ---
# STORAGE_TIPO: s3 (MinIO u otro almacenamiento compatible con S3) o memoria (sin servicios externos, los archivos se pierden al reiniciar)
STORAGE_TIPO=s3
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_BUCKET=planilla360-boletas
STORAGE_ACCESS_KEY=planilla360
STORAGE_SECRET_KEY=planilla360-local
MINIO_ROOT_USER=planilla360
MINIO_ROOT_PASSWORD=planilla360-local

# --- Mensajería y correo ---
# MESSAGING_ENABLED=false degrada con elegancia: las boletas y los correos se procesan en el mismo proceso.
MESSAGING_ENABLED=true
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
MAIL_HOST=127.0.0.1
MAIL_PORT=1025

# --- Servicios externos (DNI, RUC, tipo de cambio): WireMock en local ---
INTEGRACION_MODO=http
INTEGRACION_BASE_URL=http://127.0.0.1:8099
WIREMOCK_PORT=8099

# --- Observabilidad (perfil "obs" de compose: Prometheus y Grafana) ---
# Credencial HTTP Basic de /actuator/prometheus. En local la API usa por defecto planilla360-metrics-local
# (la misma que lee Prometheus desde docker/prometheus/metrics-password). Fuera de local, sin METRICS_PASSWORD
# el endpoint queda cerrado.
METRICS_USER=prometheus
METRICS_PASSWORD=planilla360-metrics-local
GRAFANA_USER=admin
GRAFANA_PASSWORD=planilla360-local
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Logs en JSON también en local (por defecto solo fuera de local):
# LOGGING_STRUCTURED_FORMAT_CONSOLE=logstash
