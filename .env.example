# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.
# Todos los valores son opcionales en local: sin .env la API usa los valores por defecto del perfil
# local (PostgreSQL de docker-compose y un JWT_SECRET efímero generado al arrancar).

SPRING_PROFILES_ACTIVE=local
PORT=8080

# --- Base de datos (docker compose y API) ---
POSTGRES_DB=planilla360
POSTGRES_USER=planilla360
POSTGRES_PASSWORD=cambia-esta-clave-local
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/planilla360
DB_USER=planilla360
DB_PASSWORD=cambia-esta-clave-local

# --- Seguridad ---
# Obligatorio en staging/prod (mínimo 32 caracteres, aleatorio). Genera uno con:  openssl rand -base64 48
# En local, si lo omites, se genera uno efímero (los tokens dejan de valer al reiniciar la API).
JWT_SECRET=
# Orígenes permitidos por CORS, separados por coma (en local: el front en http://localhost:4200).
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Primer administrador (solo staging/prod; en local los crea el seed) ---
# Si defines correo y contraseña, la API crea ese ADMIN_SAAS al arrancar cuando no existe (nunca cambia una clave existente).
# La contraseña: 10 a 72 caracteres con letras y números. Ponla solo en el panel del servicio, nunca en el repo.
ADMIN_INICIAL_EMAIL=
ADMIN_INICIAL_PASSWORD=
ADMIN_INICIAL_NOMBRE=

# --- Caché y mensajería (perfil "messaging" de compose) ---
# CACHE_TYPE=redis activa Redis; con "simple" (por defecto) la caché es en memoria.
CACHE_TYPE=simple
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
RABBITMQ_USER=planilla360
RABBITMQ_PASSWORD=cambia-esta-clave-local

# --- Almacenamiento de boletas (MinIO local; Cloudflare R2 en staging/prod) ---
# STORAGE_TIPO: s3 (MinIO/R2) o memoria (sin servicios externos, los archivos se pierden al reiniciar)
STORAGE_TIPO=s3
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_BUCKET=planilla360-boletas
STORAGE_ACCESS_KEY=planilla360
STORAGE_SECRET_KEY=cambia-esta-clave-local
MINIO_ROOT_USER=planilla360
MINIO_ROOT_PASSWORD=cambia-esta-clave-local

# --- Mensajería y correo ---
# MESSAGING_ENABLED=false degrada con elegancia: las boletas y los correos se procesan en el mismo proceso.
MESSAGING_ENABLED=true
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
MAIL_HOST=127.0.0.1
MAIL_PORT=1025

# --- Servicios externos (DNI, RUC, tipo de cambio): WireMock en local ---
INTEGRACION_MODO=http
INTEGRACION_BASE_URL=http://127.0.0.1:8099
WIREMOCK_PORT=8099

# --- Observabilidad (perfil "obs" de compose: Prometheus y Grafana) ---
# Credencial HTTP Basic de /actuator/prometheus. En local la API usa por defecto planilla360-metrics-local
# (la misma que lee Prometheus desde docker/prometheus/metrics-password). En staging/prod, sin METRICS_PASSWORD
# el endpoint queda cerrado.
METRICS_USER=prometheus
METRICS_PASSWORD=
GRAFANA_USER=admin
GRAFANA_PASSWORD=cambia-esta-clave-local
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Logs en JSON también en local (por defecto solo en staging/prod):
# LOGGING_STRUCTURED_FORMAT_CONSOLE=logstash
